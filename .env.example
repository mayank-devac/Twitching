# Copy only names/settings; put real credentials in .env.local.
# Leave every TWITCH_* field empty to skip Twitch, or pass --skip twitch.
# YOUTUBE_LIVE_CHAT_ID can stay empty; startup looks it up unless you pass --skip yt.
TYPESAFE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_LIVE_CHAT_ID=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
KICK_ACCESS_TOKEN=
KICK_BROADCASTER_ID=
OBS_PASSWORD=
